{
  "name": "opens-test",
  "displayName": "Opens Test",
  "description": "A stand-in for another EDGE tool: it claims TweakDB records through the open contract (REDcode issue #22) and calls openAnimation (REDcode issue #21) and revealInProject (#27). For REDcode's hand tests only; never published.",
  "version": "0.0.1",
  "publisher": "edgemodders",
  "private": true,
  "license": "MIT",
  "engines": { "vscode": "^1.74.0" },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "openstest.open", "title": "Opens Test: Open" },
      { "command": "openstest.openAnimation", "title": "Opens Test: Open an Animation" },
      { "command": "openstest.openAnimationNotAnims", "title": "Opens Test: Open an Animation from a File That Is Not One" },
      { "command": "openstest.revealInProject", "title": "Opens Test: Reveal in Project" }
    ]
  },
  "edgemodders": {
    "opens": [
      { "tweakdb": { "type": "Item", "flat": "itemType", "is": "ItemType.Prt_Program" }, "command": "openstest.open" },
      { "tweakdb": { "type": "ObjectAction", "flat": "isQuickHack", "is": true }, "command": "openstest.open" }
    ]
  }
}
